# Copie para .env e preencha. O instalar.sh faz isso para voce.

# Endereco do servidor (o subdominio do DuckDNS, sem https://)
DOMINIO=algumacoisa.duckdns.org

# Senha do banco. Use algo longo e aleatorio; o instalador gera uma.
POSTGRES_PASSWORD=troque-esta-senha

# Opcional: token do DuckDNS, para manter o IP atualizado sozinho.
DUCKDNS_TOKEN=

# Client ID "Web" do Google Cloud, usado para conferir o login.
# Sem ele, o servidor sobe mas recusa qualquer login.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxx.apps.googleusercontent.com

# Opcional: credencial de conta de servico do Firebase, para notificacao push.
# Baixe o JSON no Firebase (Configuracoes do projeto > Contas de servico >
# Gerar nova chave privada), comprima numa linha so com `jq -c . arquivo.json`
# e cole o resultado aqui. Sem isso, o app so sincroniza pelo ciclo periodico
# e pelo SSE (com o app aberto) — ver docs/06-notificacao-push.md.
FIREBASE_SERVICE_ACCOUNT_JSON=
